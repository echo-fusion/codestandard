{
    "name": "echo-fusion/codestandard",
    "description": "This project contains the code standard for echoFusion framework",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/echo-fusion/codestandard",
    "authors": [
        {
            "name": "Amir Shadanfar",
            "email": "a.shadanfar.it@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/echo-fusion/codestandard/issues",
        "source": "https://github.com/echo-fusion/codestandard"
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "vimeo/psalm": "^5.26"
    },
    "autoload": {
        "psr-4": {
            "EchoFusion\\CodeStandard\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "test": [
            "@cs-check",
            "@analyze"
        ],
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "analyze": "psalm --show-info=false --no-cache --no-progress"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
